
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Examen SONDA</title>

    <link href="~/Plugins/bootstrap-4.2.1-dist/css/bootstrap.css" rel="stylesheet" />
    <link href="~/Plugins/bootstrap-4.2.1-dist/css/bootstrap-grid.css" rel="stylesheet" />
    <link href="~/Plugins/bootstrap-4.2.1-dist/css/bootstrap-reboot.css" rel="stylesheet" />
    <link href="~/Plugins/datatables/media/css/dataTables.bootstrap.css" rel="stylesheet" />
    <link href="~/Plugins/datatables/media/css/dataTables.jqueryui.css" rel="stylesheet" />

    <script src="~/Plugins/jquery/jquery-3.3.1.js"></script>
    <script src="~/Plugins/jquery/jquery-3.3.1.slim.js"></script>
    <script src="~/Plugins/jquery-ui/jquery-ui.js"></script>
    <script src="~/Plugins/bootstrap-4.2.1-dist/js/bootstrap.js"></script>
    <script src="~/Plugins/bootstrap-4.2.1-dist/js/bootstrap.bundle.js"></script>
    <script src="~/Plugins/datatables/media/js/dataTables.bootstrap.js"></script>
    <script src="~/Plugins/datatables/media/js/dataTables.jqueryui.js"></script>
    <script src="~/Scripts/Home/Index.init.js"></script>

</head>
<body>
    <div  class="col-lg-12 row"> 
        <div class="row">
            <div class="col-lg-12">
                <h4 class="page-header">Mantenimiento</h4>
            </div>
        </div>
        <div class="panel panel-default">
            <div class="panel-body">
                <div class="row">
                    <form role="form">
                        @* Controles de busqueda *@
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label>Nombre</label>
                                <input type="text" class="form-control input-sm" id="inp-nombre" />
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label>Apellidos</label>
                                <input type="text" class="form-control input-sm" id="inp-apellidos" />
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label>Fecha nacimiento</label>
                                <div class="input-group date">
                                    <input id="inp-fecha-nacimiento" type="text" class="form-control input-sm datepicker" />
                                    <div class="input-group-addon">
                                        <span class="glyphicon glyphicon-calendar fa fa-calendar"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label>Sexo</label>
                                <select id="slc-sexo" class="form-control input-sm ddlSexo">
                                    <option value="0" selected="selected">(Seleccionar)</option>
                                    <option value="M">Masculino</option>
                                    <option value="F">Femenino</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="col-lg-12">
                            <button type="button" id="btn-insertar" class="btn btn-primary">Insertar</button>
                            <input type="hidden" id="inp-id" value="0" />
                        </div>
                    </form>
                </div>

                @* Datatable *@
                <div class="row">
                    <div class="form-group col-lg-12">
                        <table id="dtt-lista-personas" class="table table-striped table-bordered table-condensed" cellspacing="0">
                            <thead>
                                <tr>
                                    <th class="text-center">Id</th>
                                    <th class="text-center">Nombre</th>
                                    <th class="text-center">Apellidos</th>
                                    <th class="text-center">Fecha Nacimiento</th>
                                    <th class="text-center">Sexo</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
